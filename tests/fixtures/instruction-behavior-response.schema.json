    "mode",
    "autonomous",
    "primaryAction",
    "publicationAuthorized",
    "mergeAuthorized",
    "deploymentAuthorized"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["investigation", "design", "quick", "standard", "careful"]
    },
    "autonomous": { "type": "boolean" },
    "primaryAction": {
      "type": "string",
      "enum": [
        "answer-read-only",
        "continue-design-discussion",
        "produce-design-artifact",
        "implement-and-deliver",
        "continue-authorized-work",
        "stop-and-report",
        "commit-only",
        "recheck-and-diagnose",
        "autonomous-readiness-checkpoint",
        "inventory-authority-checkpoint",
        "deliver-pilot-before-fanout"
      ]
    },
    "publicationAuthorized": { "type": "boolean" },
    "mergeAuthorized": { "type": "boolean" },
    "deploymentAuthorized": { "type": "boolean" }
  }
}
