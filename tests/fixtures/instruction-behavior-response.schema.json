{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "autonomous",
    "primaryAction",
    "workLimit",
    "hangTimeout",
    "publicationAuthorized",
    "publicationActor",
    "mergeAuthorized",
    "deploymentAuthorized",
    "blockerSource"
  ],
  "properties": {
    "autonomous": { "type": "boolean" },
    "primaryAction": {
      "type": "string",
      "description": "mark-ready-and-verify means issue a Ready mutation and then verify live state. refresh-live-state means read current state, including verifying a Ready mutation already issued successfully. keep-draft-and-report means retain draft and report unfinished PR work or the applicable restriction.",
      "enum": [
        "answer-read-only",
        "continue-design-discussion",
        "produce-design-artifact",
        "implement-and-deliver",
        "continue-authorized-work",
        "integrate-merge-commit",
        "integrate-rebase",
        "integrate-squash",
        "integrate-cherry-pick",
        "stop-and-report",
        "close-review-with-validation",
        "run-scoped-review",
        "clarify-ownership",
        "isolate-and-continue",
        "report-blocker",
        "commit-only",
        "recheck-and-diagnose",
        "autonomous-readiness-checkpoint",
        "inventory-authority-checkpoint",
        "deliver-pilot-before-fanout",
        "refresh-live-state",
        "mark-ready-and-verify",
        "keep-draft-and-report",
        "obtain-evidence-yourself"
      ]
    },
    "workLimit": { "type": "string", "enum": ["not-applicable", "no-limit", "time-limited"] },
    "hangTimeout": { "type": "string", "enum": ["not-applicable", "bounded", "unbounded"] },
    "publicationAuthorized": { "type": "boolean" },
    "publicationActor": {
      "type": "string",
      "enum": ["not-applicable", "current-session", "kamkie-codex-bot", "repository-defined"]
    },
    "mergeAuthorized": { "type": "boolean" },
    "deploymentAuthorized": { "type": "boolean" },
    "blockerSource": { "type": "string", "enum": ["none", "repository", "skill", "tool", "access", "ambiguity"] }
  }
}
